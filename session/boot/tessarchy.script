Window.SetBackgroundTopColor(0.031373, 0.070588, 0.141176);
Window.SetBackgroundBottomColor(0.031373, 0.070588, 0.141176);
Plymouth.SetRefreshRate(20);

fun minimum(a, b)
{
    if (a < b) return a;
    return b;
}
size = minimum(720, minimum(Window.GetWidth() * 0.92, Window.GetHeight() * 0.85));
logo = Sprite(Image("logo-0.png").Scale(size, size));
logo.SetPosition(Window.GetX() + (Window.GetWidth() - size) / 2,
                 Window.GetY() + (Window.GetHeight() - size) / 2, 1);
status = Sprite();
entry = Sprite();
frame = 0;
mode = "normal";

# The clip assembles the mark, holds it, then fades it out in its last frames.
# Playing to the end and stopping there leaves the screen empty (just the dark
# background and the cursor) for the rest of the boot, which reads as a failed
# splash. Hold the settled frame instead: logo-rest.png is exported by
# scripts/export-boot-assets.py as the brightest frame of the clip, and
# test_boot.py asserts the two stay in step.
REST_FRAME = 120;

fun center_text(sprite, text, y)
{
    image = Image.Text(text, 0.78, 0.86, 0.89, 1, "DejaVu Sans 11");
    sprite.SetImage(image);
    sprite.SetPosition(Window.GetX() + (Window.GetWidth() - image.GetWidth()) / 2, y, 10);
}

fun refresh()
{
    if (mode != "normal") return;
    if (frame < REST_FRAME)
    {
        global.frame++;
        logo.SetImage(Image("logo-" + frame + ".png").Scale(size, size));
        return;
    }
    if (frame == REST_FRAME)
    {
        global.frame++;
        logo.SetImage(Image("logo-rest.png").Scale(size, size));
    }
}

fun normal()
{
    global.mode = "normal";
    status.SetOpacity(0);
    entry.SetOpacity(0);
}

fun password(prompt, count)
{
    global.mode = "password";
    bullets = "";
    for (i = 0; i < minimum(count, 32); i++) bullets += "•";
    center_text(status, prompt, Window.GetY() + Window.GetHeight() * 0.88);
    center_text(entry, bullets, Window.GetY() + Window.GetHeight() * 0.88 + 32);
    status.SetOpacity(1);
    entry.SetOpacity(1);
}

fun question(prompt, text)
{
    global.mode = "question";
    center_text(status, prompt, Window.GetY() + Window.GetHeight() * 0.88);
    center_text(entry, text, Window.GetY() + Window.GetHeight() * 0.88 + 32);
    status.SetOpacity(1);
    entry.SetOpacity(1);
}

fun message(text) {}
fun quit() {}
Plymouth.SetRefreshFunction(refresh);
Plymouth.SetDisplayNormalFunction(normal);
Plymouth.SetDisplayPasswordFunction(password);
Plymouth.SetDisplayQuestionFunction(question);
Plymouth.SetDisplayMessageFunction(message);
Plymouth.SetQuitFunction(quit);
