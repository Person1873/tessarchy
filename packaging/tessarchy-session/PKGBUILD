pkgname=tessarchy-session
pkgver=0.1.0
pkgrel=2
pkgdesc='Tessarchy prototype Hyprland session'
arch=('any')
license=('MIT')
depends=('tessera-shell=0.1.0' 'hyprland>=0.56' 'hypridle' 'dbus' 'firefox' 'foot' 'ttf-dejavu' 'grim' 'libnotify')
optdepends=('squeekboard: on-screen keyboard for touch text input')
source=("tessarchy-$pkgver.tar.gz")
sha256sums=('SKIP')
package() {
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$srcdir/session/hyprland.lua" "$pkgdir/usr/share/tessarchy/session/hyprland.lua"
    install -Dm644 "$srcdir/session/hypridle.conf" "$pkgdir/usr/share/tessarchy/session/hypridle.conf"
    install -Dm755 "$srcdir/session/start-tessarchy" "$pkgdir/usr/bin/start-tessarchy"
    install -Dm755 "$srcdir/session/tessera-screenshot" "$pkgdir/usr/bin/tessera-screenshot"
    install -Dm755 "$srcdir/session/tessarchy-session-services" "$pkgdir/usr/bin/tessarchy-session-services"
    install -Dm755 "$srcdir/session/tessarchy-osk" "$pkgdir/usr/bin/tessarchy-osk"
    install -Dm644 "$srcdir/session/tessarchy.desktop" "$pkgdir/usr/share/wayland-sessions/tessarchy.desktop"
}
