# Maintainer: Tessarchy <tessarchy@thediamondsaint.dev>
pkgname=tessarchy-update
pkgver=0.1.0
pkgrel=1
pkgdesc='Update an installed Tessarchy in place from its package repository'
arch=('any')
license=('MIT')
depends=('python' 'pacman')
optdepends=('libnotify: desktop notice when an update is published')
source=("tessarchy-$pkgver.tar.gz")
# Local development source archive, generated by scripts/package.sh.
# Replace SKIP with a recorded checksum for release builds.
sha256sums=('SKIP')
backup=('etc/pacman.d/tessarchy.conf')

package() {
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm755 "$srcdir/session/tessarchy-update" "$pkgdir/usr/bin/tessarchy-update"
    install -Dm755 "$srcdir/session/tessera-update-notify" "$pkgdir/usr/bin/tessera-update-notify"
    install -Dm644 "$srcdir/iso/airootfs/etc/pacman.d/tessarchy.conf" \
        "$pkgdir/etc/pacman.d/tessarchy.conf"
    install -Dm644 "$srcdir/iso/airootfs/etc/systemd/system/tessarchy-update-check.service" \
        "$pkgdir/usr/lib/systemd/system/tessarchy-update-check.service"
    install -Dm644 "$srcdir/iso/airootfs/etc/systemd/system/tessarchy-update-check.timer" \
        "$pkgdir/usr/lib/systemd/system/tessarchy-update-check.timer"
    install -Dm644 "$srcdir/iso/airootfs/etc/sudoers.d/tessarchy-update" \
        "$pkgdir/etc/sudoers.d/tessarchy-update"
    chmod 440 "$pkgdir/etc/sudoers.d/tessarchy-update"
    install -Dm644 "$srcdir/iso/airootfs/etc/skel/.config/systemd/user/tessarchy-update-notify.service" \
        "$pkgdir/etc/skel/.config/systemd/user/tessarchy-update-notify.service"
    install -Dm644 "$srcdir/iso/airootfs/etc/skel/.config/systemd/user/tessarchy-update-notify.timer" \
        "$pkgdir/etc/skel/.config/systemd/user/tessarchy-update-notify.timer"
}
